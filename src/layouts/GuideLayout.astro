---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
  badge: string;
  currentPath?: string;
}

const { title, description, badge, currentPath = Astro.url.pathname } = Astro.props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#0d9488" />
  <style is:global>
    .markdown-content {
      line-height: 1.85;
      font-size: 1.05rem;
    }
    .markdown-content h1 {
      font-size: 2.1rem;
      color: var(--pico-primary);
      margin-bottom: 1rem;
    }
    .markdown-content h2 {
      font-size: 1.55rem;
      color: var(--pico-primary);
      border-bottom: 2px solid var(--pico-muted-border-color);
      padding-bottom: 0.5rem;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
    }
    .markdown-content h3 {
      font-size: 1.25rem;
      color: var(--pico-h2-color);
      margin-top: 1.75rem;
      margin-bottom: 0.5rem;
    }
    .markdown-content ul {
      padding-right: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .markdown-content li {
      margin-bottom: 0.5rem;
    }
    .markdown-content hr {
      margin: 2.5rem 0;
      border-color: var(--pico-muted-border-color);
    }
    .guide-container {
      max-width: 920px;
      margin: 0 auto;
      padding: 1.5rem 1rem 4rem;
    }
  </style>
</head>

<body>
  <!-- Ribbon -->
  <div class="sadaqah-ribbon">
    <span>🌿 صدقة جارية - نسألكم الدعاء لوالدينا ولموتى المسلمين بالرحمة والمغفرة</span>
  </div>

  <!-- Page Body with Sidebar -->
  <div class="page-body">
    <Sidebar currentPath={currentPath} />

    <div class="page-content">
      <main class="guide-container">
        <div style="margin-bottom: 1.5rem;">
          <span class="badge badge-category" style="font-size: 0.9rem; margin-bottom: 0.5rem;">{badge}</span>
        </div>

        <!-- Rendered Markdown Body -->
        <article class="markdown-content">
          <slot />
        </article>

        <!-- Bottom Navigation -->
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--pico-muted-border-color);">
          <a href={`${import.meta.env.BASE_URL}/`} role="button" class="outline" style="font-weight: 700; padding: 0.75rem 1.5rem;">
            ← العودة لموسوعة التحاليل
          </a>
          <a href={`${import.meta.env.BASE_URL}/lab-setup`} role="button" style="font-weight: 700; padding: 0.75rem 1.5rem;">
            دليل تأسيس المعامل 🏥
          </a>
          <a href={`${import.meta.env.BASE_URL}/syndicate`} role="button" class="secondary" style="font-weight: 700; padding: 0.75rem 1.5rem;">
            دليل نقابة العلميين والتراخيص 📜
          </a>
        </div>
      </main>

      <!-- Footer -->
      <footer class="site-footer">
        <div class="container">
          <div class="quran-quote">
            « وَمَنْ أَحْيَاهَا فَكَأَنَّمَا أَحْيَا النَّاسَ جَمِيعًا »
          </div>
          <p style="margin-bottom: 0.5rem; font-weight: 600;">
            مرجع التحاليل الطبية الشامل - صُمم لخدمة المرضى والباحثين وطلبة الطب والعلوم الطبية
          </p>
          <div class="footer-credits">
            مبني باستخدام Astro و Preact و Pico CSS • صدقة جارية بنية الأجر والثواب للجميع
          </div>
        </div>
      </footer>
    </div>
  </div>
</body>
</html>
