---
import '../styles/global.css';
import { medicalAnalyses } from '../data/analyses';
import MedicalExplorer from '../components/MedicalExplorer';
import Sidebar from '../components/Sidebar.astro';

const title = "مرجع التحاليل الطبية الشامل | صدقة جارية";
const description = "دليل وموسوعة التحاليل الطبية المخبرية باللغة العربية: النطاقات الطبيعية، شروط الصيام، وأسباب ارتفاع وانخفاض النتائج.";
---

<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  
  <!-- Primary SEO Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content="تحاليل طبية, تأسيس معمل تحاليل, ترخيص معمل تحاليل, نقابة المهن العلمية, صورة دم كاملة, وظائف كبد, وظائف كلى, سكر تراكمي, كوليسترول, صيام التحاليل" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="ar_AR" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta name="theme-color" content="#0d9488" />
</head>

<body>
  <!-- Sadaqah Jariyah Ribbon -->
  <div class="sadaqah-ribbon">
    <span>🌿 صدقة جارية - نسألكم الدعاء لوالدينا ولموتى المسلمين بالرحمة والمغفرة</span>
  </div>

  <!-- Page Body with Sidebar -->
  <div class="page-body">
    <Sidebar currentPath="/" />

    <div class="page-content">
      <!-- Hero Section -->
      <main class="container">
        <section class="site-header">
          <h1 class="site-title">
            <span>موسوعة التحاليل الطبية</span>
          </h1>
          <p class="site-subtitle">
            دليلك الموثوق لفهم وتفسير الفحوصات المخبرية، شروط إجرائها والصيام، ونطاقاتها الطبيعية باللغة العربية البسيطة.
          </p>

          <!-- Stats Bar -->
          <div class="stats-bar">
            <div class="stat-item">
              <span class="stat-num">{medicalAnalyses.length}</span>
              <span class="stat-title">تحاليل مفصلة</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">8</span>
              <span class="stat-title">أقسام مخبرية</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">10</span>
              <span class="stat-title">أبواب تأسيس المعمل</span>
            </div>
            <div class="stat-item">
              <span class="stat-num">100%</span>
              <span class="stat-title">مجاني ومتاح للجميع</span>
            </div>
          </div>
        </section>

        <!-- Quick Master Guides Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
          <div style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.1), rgba(16, 185, 129, 0.08)); border: 1px solid rgba(13, 148, 136, 0.3); border-radius: var(--card-radius); padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <strong style="color: var(--pico-primary); font-size: 1.15rem; display: block; margin-bottom: 0.35rem;">
                🏥 دليل تأسيس وترخيص معمل تحاليل
              </strong>
              <span style="font-size: 0.95rem; color: var(--pico-muted-color); line-height: 1.6; display: block; margin-bottom: 1rem;">
                المواصفات المعمارية، الأجهزة التشخيصية، البنشات، موانع الرفض القاتلة لوزارة الصحة، وقواعد المعاينة.
              </span>
            </div>
            <a href={`${import.meta.env.BASE_URL}/lab-setup`} role="button" style="font-size: 0.9rem; padding: 0.5rem 1rem; font-weight: 700; width: 100%; text-align: center;">
              فتح دليل تأسيس المعمل ←
            </a>
          </div>

          <div style="background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(99, 102, 241, 0.08)); border: 1px solid rgba(37, 99, 235, 0.3); border-radius: var(--card-radius); padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <strong style="color: #2563eb; font-size: 1.15rem; display: block; margin-bottom: 0.35rem;">
                📜 دليل نقابة العلميين والتراخيص
              </strong>
              <span style="font-size: 0.95rem; color: var(--pico-muted-color); line-height: 1.6; display: block; margin-bottom: 1rem;">
                أوراق القيد كأخصائي تحاليل، استخراج ترخيص مزاولة المهنة (نموذج 13 صحة)، وإجراءات تعديل البطاقة.
              </span>
            </div>
            <a href={`${import.meta.env.BASE_URL}/syndicate`} role="button" class="secondary" style="font-size: 0.9rem; padding: 0.5rem 1rem; font-weight: 700; width: 100%; text-align: center;">
              فتح دليل النقابة وتعديل المهنة ←
            </a>
          </div>
        </div>

        <!-- Preact Interactive Island -->
        <MedicalExplorer client:load analyses={medicalAnalyses} />

        <!-- About & Developer Section -->
        <section id="about" style="margin-top: 4rem; padding: 2rem; border-radius: var(--card-radius); background: var(--pico-card-background-color); border: 1px solid var(--pico-muted-border-color); box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; align-items: center;">
            <div>
              <span class="badge" style="background: rgba(13, 148, 136, 0.12); color: var(--pico-primary); font-size: 0.85rem; margin-bottom: 0.75rem;">
                👨‍💻 إشراف وتطوير المشروع
              </span>
              <h2 style="font-size: 1.6rem; color: var(--pico-primary); margin: 0 0 0.5rem 0;">
                أحمد علاء (Ahmed Alaa)
              </h2>
              <p style="font-size: 0.98rem; color: var(--pico-color); line-height: 1.7; margin-bottom: 1rem;">
                صُممت وطُوّرت هذه الموسوعة المعملية بجهود تطوعية خالصة لتوفير مرجع تقني وطبي دقيق وشامل ومجاني تماماً باللغة العربية، يخدم طلبة العلوم الطبية، وأخصائيي التحاليل، والمرضى.
              </p>

              <!-- Contact & Links -->
              <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
                <a href="https://github.com/ahmedadev" target="_blank" rel="noopener" role="button" class="outline" style="font-size: 0.85rem; padding: 0.4rem 0.9rem; font-weight: 700;">
                  🐙 GitHub: ahmedadev
                </a>
                <a href="mailto:ahmedaboalaa012@gmail.com" role="button" class="outline secondary" style="font-size: 0.85rem; padding: 0.4rem 0.9rem; font-weight: 700;">
                  ✉️ ahmedaboalaa012@gmail.com
                </a>
              </div>
            </div>

            <!-- Sadaqah & Purpose Card -->
            <div style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.08), rgba(16, 185, 129, 0.05)); border: 1px solid rgba(13, 148, 136, 0.25); border-radius: 12px; padding: 1.25rem;">
              <strong style="color: var(--pico-primary); font-size: 1.05rem; display: block; margin-bottom: 0.5rem;">
                🌿 نية المشروع والصدقة الجارية
              </strong>
              <p style="font-size: 0.92rem; line-height: 1.7; margin-bottom: 0.75rem; color: var(--pico-color);">
                هذا العمل وقف علمي لوجه الله تعالى وصدقة جارية بنية الأجر والثواب للوالدين ولموتى المسلمين جميعاً. نسألكم صالح الدعاء بالرحمة والمغفرة.
              </p>
              <div style="font-size: 0.85rem; color: var(--pico-muted-color); border-top: 1px solid rgba(13, 148, 136, 0.2); padding-top: 0.5rem;">
                <strong>⚠️ تنبيه طبي:</strong> المعلومات الواردة استرشادية وتوعوية ولا تغني عن استشارة الطبيب المعالج والتحقق المعملي المباشر.
              </div>
            </div>
          </div>
        </section>
      </main>

      <!-- Site Footer -->
      <footer class="site-footer">
        <div class="container">
          <div class="quran-quote">
            « وَمَنْ أَحْيَاهَا فَكَأَنَّمَا أَحْيَا النَّاسَ جَمِيعًا »
          </div>
          <p style="margin-bottom: 0.5rem; font-weight: 600;">
            مرجع التحاليل الطبية الشامل - صُمم لخدمة المرضى والباحثين وطلبة الطب والعلوم الطبية
          </p>
          <div class="footer-credits">
            مبني باستخدام Astro و Preact و Pico CSS • صدقة جارية بنية الأجر والثواب للجميع
          </div>
        </div>
      </footer>
    </div>
  </div>
</body>
</html>
